+def _box_clearance(points, box):
+    """Signed point-to-oriented-box distance (positive outside, negative inside)."""
+    _, centre, size, R = box[:4]
+    L = np.abs((np.asarray(points) - np.asarray(centre)) @ np.asarray(R)) - np.asarray(size) / 2
+    return float((np.linalg.norm(np.maximum(L, 0.0), axis=1) + np.minimum(L.max(1), 0.0)).min())
+
+
+def _tool_cloud(length=0.12, radius=0.06):
+    z = np.linspace(0.0, length, 13)
+    a = np.linspace(0.0, 2 * np.pi, 20, endpoint=False)
+    rings = [np.c_[radius * np.cos(a), radius * np.sin(a), np.full(len(a), zz)] for zz in z]
+    return np.vstack(rings + [np.c_[np.zeros(len(z)), np.zeros(len(z)), z]])
+
+
+def obstacle_clearance(k, knots_deg, boxes, local_cloud, per=24):
+    """Minimum clearance of a sparse controller spline to observed/remembered plates."""
+    if not boxes:
+        return float('inf')
+    dense, _ = pp.equal_time_spline(np.asarray(knots_deg, float), per=per)
+    best = float('inf')
+    for q in dense:
+        F = k.fk(np.radians(q))
+        world = np.asarray(local_cloud) @ F[:3, :3].T + F[:3, 3]
+        best = min(best, *(_box_clearance(world, b) for b in boxes))
+    return best
+
+
+def plate_obstacles(basket_data, Tbb, plate_specs):
+    """Fuse live YOLOE+depth boxes with slots remembered after successful releases."""
+    live = [tuple(b[:4]) for b in basket_data.get('basket_obstacles', [])]
+    known = []
+    # A live OBB contains the actual lean/orientation, so do not also add the
+    # coarser slot model for the same scene.  Remembered slots are fail-safe
+    # fallback only when YOLOE/depth did not return any basket plate.
+    if plate_specs and not live:
+        rq = pp.robot_quadrants(Tbb)
+        slots = []
+        for spec in plate_specs:
+            qd, pin = spec.split(':')
+            model_q = rq[qd]
+            slots.append((model_q, pp.pin_gap(Tbb, model_q, int(pin))))
+        known = [b for b in pp.basket_boxes(Tbb, plates=slots) if b[0].startswith('plate_')]
+    return live + known, len(live), len(known)
+
+
