+def basket_obstacle_boxes(det, depth, K, Tbc, Tbb, posj=None, min_conf=0.25, min_points=80, pad=0.015):
+    """YOLOE plates whose depth centre lies inside the fitted basket -> base-frame OBBs.
+
+    These are deliberately separate from :func:`obstacle_boxes`, which keeps
+    plates on the table.  A later pick cycle consumes these boxes as standing
+    obstacles.  The plate mask is eroded before back-projection so rack wires
+    and depth bleeding at the silhouette do not enlarge the box excessively.
+    """
+    from scipy.spatial import cKDTree
+    out, Tbi = [], np.linalg.inv(np.asarray(Tbb, float))
+    arm = cKDTree(arm_points(posj)) if posj is not None else None
+    for i, (mk, conf) in enumerate(getattr(det, 'plate_masks', [])):
+        if conf < min_conf:
+            continue
+        inner = cv2.erode(mk.astype(np.uint8), np.ones((5, 5), np.uint8)).astype(bool)
+        P, _ = cloud(inner, depth, K, Tbc)
+        P = P[P[:, 2] > 0.0]                                  # remove the table below the basket
+        if arm is not None and len(P):
+            dist, _ = arm.query(P)
+            P = P[dist > 0.04]
+        if len(P) < min_points:
+            continue
+        med = np.median(P, axis=0)
+        P = P[np.linalg.norm(P - med, axis=1) < 0.22]          # reject depth bleeding off the plate rim
+        if len(P) < min_points:
+            continue
+        local = (Tbi @ np.r_[np.median(P, axis=0), 1.0])[:3]
+        if not (abs(local[0]) < 0.30 and abs(local[1]) < 0.29 and -0.19 < local[2] < 0.10):
+            continue
+        mu = P.mean(0)
+        _, _, Vt = np.linalg.svd(P - mu, full_matrices=False)
+        R = Vt.T
+        if np.linalg.det(R) < 0:
+            R[:, -1] *= -1
+        L = (P - mu) @ R
+        lo, hi = np.percentile(L, 2, axis=0), np.percentile(L, 98, axis=0)
+        raw = hi - lo
+        # A real plate is about 27 cm across.  Reject a mask dominated by the
+        # basket/background rather than publishing a huge false obstacle.
+        if raw.max() > 0.40 or np.partition(raw, -2)[-2] > 0.36:
+            continue
+        size = np.maximum(raw + 2 * pad, [0.035, 0.035, 0.035])
+        centre = mu + R @ ((lo + hi) / 2)
+        out.append((f'basket_plate_{i}', np.round(centre, 4).tolist(), np.round(size, 4).tolist(),
+                    np.round(R, 5).tolist(), round(float(conf), 3), int(len(P))))
+    return out
+
+
